# Configuration de la base de données
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=formateur_management

# Configuration JWT
JWT_SECRET=votre_secret_jwt_tres_securise_changez_moi

# Configuration du serveur
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Configuration Email (Nodemailer)
# Pour Gmail, créez un "Mot de passe d'application" dans votre compte Google
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=votre.email@gmail.com
EMAIL_PASSWORD=votre_mot_de_passe_application
EMAIL_FROM=Centre de Formation <votre.email@gmail.com>

# Note: Pour utiliser Gmail:
# 1. Allez dans votre compte Google
# 2. Sécurité → Validation en deux étapes (activez-la si ce n'est pas fait)
# 3. Sécurité → Mots de passe des applications
# 4. Créez un mot de passe pour "Autre (nom personnalisé)" → "Centre Formation"
# 5. Copiez le mot de passe généré dans EMAIL_PASSWORD ci-dessus
